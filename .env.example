# Required: Finnhub API token (https://finnhub.io/)
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Default Nasdaq ticker to track
STOCK_SYMBOL=ANT

# HTTP server port
PORT=3000

# REST quote snapshot refresh interval (10–300 seconds)
QUOTE_REFRESH_SECONDS=30

# Optional Telegram push alerts (recommended for alerts when browser is closed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
