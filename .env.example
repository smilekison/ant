# Finnhub API token (https://finnhub.io/)
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Nasdaq ticker to track
STOCK_SYMBOL=ANT

# Node.js HTTP port
PORT=3000

# Automatic quote and dashboard status refresh (3–15 seconds; default 5)
QUOTE_REFRESH_SECONDS=5

