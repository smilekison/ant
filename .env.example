# Finnhub API token (https://finnhub.io/)
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Nasdaq ticker to track
STOCK_SYMBOL=ANT

# Node.js HTTP port
PORT=3000

# Automatic quote and dashboard status refresh (3–15 seconds; default 5)
QUOTE_REFRESH_SECONDS=5

# Paper trading safeguards (simulated account only)
PAPER_MAX_ORDER_QTY=1000
PAPER_MAX_ORDER_NOTIONAL=100000
PAPER_DAILY_LOSS_LIMIT=1000
# Optional persistent data directory (keep outside the repository)
DATA_DIR=/var/lib/ant
