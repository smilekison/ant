# Required: Finnhub API token (https://finnhub.io/)
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Default Nasdaq ticker
STOCK_SYMBOL=ANT

# HTTP server port
PORT=3000

# Optional: persistent writable directory for alerts and first-trade state
# DATA_DIR=/absolute/path/to/ant-data

# Optional Telegram push alerts (recommended when the dashboard is closed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
